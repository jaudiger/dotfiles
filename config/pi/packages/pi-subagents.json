{
  "artifactDir": "session",
  "asyncByDefault": true,
  "completionBatch": {
    "enabled": true
  },
  "fleetView": true,
  "inlineToolDisplay": "summary",
  "maxActiveAsyncRunsPerSession": 4,
  "maxSubagentDepth": 1,
  "missions": {
    "enabled": true,
    "directory": "~/.pi/agent/missions",
    "globalIndex": true,
    "retainTerminal": 128
  },
  "parallel": {
    "concurrency": 4,
    "maxTasks": 8
  },
  "scheduledRuns": {
    "enabled": true,
    "maxPending": 20
  },
  "toolDescriptionMode": "compact",
  "waitTool": {
    "enabled": true
  }
}
